{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputMode",
    "prompt",
    "referenceImages",
    "durationSeconds",
    "fps",
    "aspectRatio",
    "resolution",
    "referenceAudios",
    "advanced"
  ],
  "properties": {
    "inputMode": {
      "type": "string",
      "const": "multi_image_to_video",
      "default": "multi_image_to_video"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "referenceImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "title": "1张有序参考图"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "default": 5
    },
    "fps": {
      "type": "integer",
      "const": 24,
      "default": 24,
      "description": "模型原生24fps，不把CreateVideo封装帧率冒充生成帧率。"
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "1:1",
        "16:9",
        "9:16",
        "4:3"
      ],
      "default": "16:9"
    },
    "referenceAudios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "title": "参考音（1段）"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "mp:0.25",
        "mp:0.4",
        "mp:0.6",
        "mp:1"
      ],
      "default": "mp:0.4",
      "title": "清晰度（MP）",
      "description": "本工作流的四个固定百万像素档位，不支持任意连续MP值。"
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioUsage"
      ],
      "default": {
        "audioUsage": "soundtrack_copy"
      },
      "properties": {
        "audioUsage": {
          "type": "string",
          "enum": [
            "soundtrack_copy"
          ],
          "default": "soundtrack_copy",
          "title": "参考音用途",
          "description": "原音驱动对口型，保留完整说话或唱歌参考音；不支持仅音色条件。"
        }
      }
    }
  }
}
