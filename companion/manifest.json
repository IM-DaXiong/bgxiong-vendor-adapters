{
  "version": "1.0.0-a04",
  "entry": "scripts/start-managed.ps1",
  "bootstrapTimeoutSec": 1800,
  "healthEndpoint": "/system_stats",
  "probeEndpoints": [
    "/object_info",
    "/h3_facerefine/videos"
  ],
  "requiredClasses": [
    "H3FaceSelect",
    "H3FaceTrackCrop",
    "H3FaceStitch",
    "H3InjectVideoLatent",
    "H3PerFrameDenoise"
  ],
  "optionalClasses": [
    "H3FaceMaskSAM"
  ],
  "upstreamCommit": "d8521d14fe0d721d80cd9417fff5a559cbc21aba",
  "upstreamVersion": "1.1.2",
  "pythonAbi": "cp311",
  "isolation": {
