  },
  "requiredFiles": [
    "manifest.json",
    "upstream-snapshot.json",
    "extra-paths/extra_model_paths.yaml",
    "scripts/start-managed.ps1",
    "scripts/prepare-runtime.ps1",
    "scripts/probe.ps1",
    "upstream/ComfyUI-H3-FaceRefine/__init__.py",
    "upstream/ComfyUI-H3-FaceRefine/nodes.py",
    "upstream/ComfyUI-H3-FaceRefine/picker_api.py",
    "upstream/ComfyUI-H3-FaceRefine/requirements.txt",
    "upstream/ComfyUI-H3-FaceRefine/pyproject.toml",
    "CONTRACT.md"
  ],
  "description": "Managed companion: isolated H3 FaceRefine 1.1.2 nodes + picker HTTP bridge (no global custom_nodes overwrite)"
}
