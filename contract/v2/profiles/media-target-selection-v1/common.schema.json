{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/common.schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegInt": {
      "type": "integer",
      "minimum": 0
    },
    "pixelBox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "timeRangeMs": {
      "type": "object",
      "properties": {
        "startMs": {
          "$ref": "#/$defs/nonNegInt"
        },
        "endMs": {
          "$ref": "#/$defs/nonNegInt"
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "displayGeometry": {
      "type": "object",
      "properties": {
        "widthPx": {
          "type": "integer",
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "minimum": 1
        },
        "rotationDegrees": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "mirrored": {
          "type": "boolean"
        }
      },
      "required": [
        "widthPx",
        "heightPx",
        "rotationDegrees",
        "mirrored"
      ],
      "additionalProperties": false
    }
  }
}
