{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/freeze.schema.json",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "source-identity.schema.json"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "analysisId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "analysisId",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "selectionDigest": {
      "type": "string",
      "minLength": 1
    },
    "trackingDigest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "dependencyVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "schemaDigest": {
      "type": "string",
      "minLength": 1
    },
    "referenceMediaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt": {
      "type": "string"
    },
    "userParams": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "source",
    "analysis",
    "selectionDigest",
    "packageVersion",
    "dependencyVersions",
    "operationId",
    "schemaDigest",
    "referenceMediaIds",
    "prompt",
    "userParams"
  ],
  "additionalProperties": false
}
