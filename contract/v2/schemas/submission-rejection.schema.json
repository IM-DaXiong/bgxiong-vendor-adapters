{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/submission-rejection.schema.json",
  "title": "SubmissionRejectionV1",
  "description": "The adapter explicitly certifies that this original submission was not accepted. Requires submission-rejection-v1 and the active original submit context. An error code alone is not this fact.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "requestDigest", "basis", "reason", "evidenceJson"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "requestDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "basis": {"enum": ["before_submission", "service_rejected"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidenceJson": {"type": "string", "minLength": 2, "maxLength": 16384}
  }
}
