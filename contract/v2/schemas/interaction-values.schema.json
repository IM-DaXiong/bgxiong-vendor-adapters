{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/interaction-values.schema.json",
  "$defs": {
    "time_span": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mediaId",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "mediaId",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "mediaId",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "mask": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "maskMediaId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mediaId",
        "maskMediaId"
      ],
      "additionalProperties": false
    }
  }
}
