{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/resolution.schema.json",
  "title": "ResolutionEvidenceV1",
  "description": "An explicitly authorized operator's reviewed evidence, not a remote receipt or permission to resubmit the same request. SDK validates structure and identity, never interprets evidence contents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "requestDigest", "outcome", "authority", "reviewedBy", "evidence", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "requestDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {"enum": ["rejected", "unresolved", "completed"]},
    "authority": {"const": "operator_reviewed"},
    "reviewedBy": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference", "sha256"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
