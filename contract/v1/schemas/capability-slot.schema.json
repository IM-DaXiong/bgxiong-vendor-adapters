{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v1/capability-slot.schema.json",
  "title": "VendorAdapterCapabilitySlot",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "taskType", "models"],
  "properties": {
    "slot": {
      "type": "string",
      "enum": [
        "image",
        "imageToImage",
        "video",
        "keyframe",
        "text",
        "speech",
        "voiceDesign",
        "sfx",
        "avatar",
        "lipsync",
        "videoUpscale",
        "videoFaceRefine",
        "imageUpscale"
      ]
    },
    "taskType": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelId", "displayName"],
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "promptProjection": { "$ref": "prompt-projection-capability.schema.json" }
        }
      }
    },
    "supportsAsync": { "type": "boolean" },
    "supportsNegativePrompt": { "type": "boolean" },
    "maxReferenceImages": { "type": "integer", "minimum": 0 },
    "maxDurationSeconds": { "type": "integer", "minimum": 0 },
    "fps": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "resolutions": { "type": "array", "items": { "type": "string" } },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["partial-outputs", "public-media", "video-reference-media-v1"]
      },
      "uniqueItems": true,
      "description": "Optional features declared for this slot (same closed set as runtime-caps slot features); unknown names rejected by host."
    },
    "mediaInputHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "boolean" },
        "videos": { "type": "boolean" },
        "audios": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["models"],
        "properties": {
          "models": { "contains": { "type": "object", "required": ["promptProjection"] } }
        }
      },
      "then": {
        "properties": { "slot": { "enum": ["video", "keyframe"] } }
      }
    }
  ]
}
