package bgxiong:vendor-adapter@1.0.0;

interface types {
  enum operation { capabilities, probe, upload, submit, query, cancel }
  enum media-kind { image, video, audio }
  enum task-status { queued, running, succeeded, failed, cancelled, expired }
  enum output-source { url, host-media, inline-base64, inline-binary }

  record invocation {
    protocol-version: u32,
    operation: operation,
    profile-id: string,
    capability-slot: string,
    request-id: string,
    deadline-ms: u64,
    payload-json: string
  }

  record adapter-error {
    code: string,
    message: string,
    retryable: bool,
    vendor-code: option<string>,
    vendor-request-id: option<string>
  }

  record response {
    protocol-version: u32,
    operation: operation,
    data-json: option<string>,
    error: option<adapter-error>
  }
}

interface host-http {
  type media-handle = string;
  type credential-handle = string;

  record header { name: string, value: string }

  record generated-header {
    name: string,
    kind: string
  }

  record field-part { name: string, value: string }
  record file-part { name: string, filename: string, handle: media-handle, mime: string }

  variant multipart-part {
    field(field-part),
    file(file-part)
  }

  variant body {
    none,
    bytes(list<u8>),
    media(media-handle),
    multipart(list<multipart-part>)
  }

  variant response-sink {
    buffer(u32),
    media
  }

  record request-plan {
    method: string,
    url: string,
    headers: list<header>,
    generated-headers: list<generated-header>,
    body: body,
    sink: response-sink,
    timeout-ms: u32
  }

  variant response-payload {
    buffered(list<u8>),
    media(media-handle)
  }

  record response {
    status: u16,
    headers: list<header>,
    payload: response-payload
  }

  record host-error {
    code: string,
    message: string
  }

  execute: func(plan: request-plan, credential: option<credential-handle>) -> result<response, host-error>;
}

interface host-media {
  type media-handle = string;

  record media-stat {
    kind: string,
    mime: string,
    byte-length: u64,
    sha256: string
  }

  media-info: func(handle: media-handle) -> result<media-stat, string>;
  media-read: func(handle: media-handle, offset: u64, max-bytes: u32) -> result<list<u8>, string>;
  media-create: func(kind: string, mime-hint: string) -> result<media-handle, string>;
  media-write: func(handle: media-handle, bytes: list<u8>) -> result<_, string>;
  media-finish: func(handle: media-handle) -> result<_, string>;
}

interface host-credential {
  type credential-handle = string;

  credential-capabilities: func(handle: credential-handle) -> result<list<string>, string>;
  sign: func(handle: credential-handle, spec-json: string) -> result<string, string>;
}

interface host-state {
  state-get: func(key: string) -> result<option<string>, string>;
  state-put: func(key: string, value: string) -> result<_, string>;
}

interface host-log {
  log: func(level: string, code: string, message: string);
}

world vendor-adapter {
  import host-http;
  import host-media;
  import host-credential;
  import host-state;
  import host-log;
  use types.{invocation, response};
  export invoke: func(request: invocation) -> response;
}
