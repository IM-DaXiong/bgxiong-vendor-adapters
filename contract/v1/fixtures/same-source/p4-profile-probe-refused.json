{
  "id": "p4-profile-probe-refused",
  "kind": "same-source",
  "schemaVersion": 1,
  "note": "Security refusal: the probe URL is outside the allowlist, so no request is made and readiness is unknown.",
  "package": {
    "language": "profile",
    "manifest": {
      "schemaVersion": 2,
      "pluginId": "local.example.same-source-profile",
      "displayName": "Same-source profile",
      "version": "1.0.0",
      "language": "profile",
      "entry": "profile.json",
      "capabilitySlots": [
        {
          "slot": "image",
          "taskType": "text_to_image",
          "models": [
            {
              "modelId": "m",
              "displayName": "M"
            }
          ]
        }
      ],
      "requestedCapabilities": {
        "endpointPolicy": [
          "staticHosts",
          "allowPrivateNetwork"
        ],
        "networkHosts": [
          "127.0.0.1"
        ],
        "allowPrivateNetwork": true,
        "auth": [
          "none"
        ]
      }
    },
    "profile": {
      "schemaVersion": 1,
      "method": "POST",
      "urlTemplate": "{vendor}/v1/images",
      "statusMap": {
        "200": "succeeded"
      },
      "probeUrl": "http://192.0.2.10:9/health"
    }
  },
  "invocation": {
    "operation": "probe",
    "capabilitySlot": "image"
  },
  "vendor": [],
  "expect": {
    "result": {
      "operation": "probe",
      "data": {
        "status": "unknown"
      }
    },
    "requests": [],
    "media": []
  }
}
