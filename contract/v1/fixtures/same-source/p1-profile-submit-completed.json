{
  "id": "p1-profile-submit-completed",
  "kind": "same-source",
  "schemaVersion": 1,
  "note": "Positive: one vendor hop, mapped to a completed URL output.",
  "package": {
    "language": "profile",
    "manifest": {
      "schemaVersion": 2,
      "pluginId": "local.example.same-source-profile",
      "displayName": "Same-source profile",
      "version": "1.0.0",
      "language": "profile",
      "entry": "profile.json",
      "capabilitySlots": [
        {
          "slot": "image",
          "taskType": "text_to_image",
          "models": [
            {
              "modelId": "m",
              "displayName": "M"
            }
          ]
        }
      ],
      "requestedCapabilities": {
        "endpointPolicy": [
          "staticHosts",
          "allowPrivateNetwork"
        ],
        "networkHosts": [
          "127.0.0.1"
        ],
        "allowPrivateNetwork": true,
        "auth": [
          "none"
        ]
      }
    },
    "profile": {
      "schemaVersion": 1,
      "method": "POST",
      "urlTemplate": "{vendor}/v1/images",
      "statusMap": {
        "200": "succeeded"
      },
      "outputUrlPointer": "/url"
    }
  },
  "invocation": {
    "operation": "submit",
    "capabilitySlot": "image",
    "payload": {
      "prompt": "hi",
      "model": "m"
    }
  },
  "vendor": [
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "url": "https://cdn.example.com/o.png"
      }
    }
  ],
  "expect": {
    "result": {
      "operation": "submit",
      "data": {
        "kind": "completed",
        "status": "succeeded",
        "usage": null,
        "outputs": [
          {
            "source": "url",
            "value": "https://cdn.example.com/o.png",
            "mediaKind": "image"
          }
        ]
      }
    },
    "requests": [
      {
        "method": "POST",
        "path": "/v1/images",
        "bodyContains": "\"prompt\":\"hi\""
      }
    ],
    "media": []
  }
}
