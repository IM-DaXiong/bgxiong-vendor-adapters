{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/profiles/media-target-selection-v1/tracking-receipt.schema.json",
  "title": "MediaTargetTrackingReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectionDigest",
    "previewMediaId",
    "coveredRange",
    "lostSpans",
    "ready"
  ],
  "properties": {
    "selectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previewMediaId": {
      "type": "string"
    },
    "coveredRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs"
      ],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lostSpans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startMs",
          "endMs",
          "reason"
        ],
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "enum": [
              "lost",
              "unresolved",
              "absent_shot"
            ]
          }
        }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reportText": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
