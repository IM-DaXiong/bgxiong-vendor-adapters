{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/source-identity.schema.json",
  "type": "object",
  "properties": {
    "mediaId": {
      "type": "string",
      "minLength": 1
    },
    "contentDigest": {
      "type": "string",
      "minLength": 1
    },
    "selectedRange": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "displayGeometry": {
      "type": "object",
      "properties": {
        "widthPx": {
          "type": "integer",
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "minimum": 1
        },
        "rotationDegrees": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "mirrored": {
          "type": "boolean"
        }
      },
      "required": [
        "widthPx",
        "heightPx",
        "rotationDegrees",
        "mirrored"
      ],
      "additionalProperties": false
    },
    "timeBase": {
      "type": "string",
      "const": "ms-from-selected-range-start"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "schemaDigest": {
      "type": "string",
      "minLength": 1
    },
    "detectionParamsDigest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "mediaId",
    "contentDigest",
    "selectedRange",
    "displayGeometry",
    "timeBase",
    "packageId",
    "operationId",
    "schemaDigest",
    "detectionParamsDigest"
  ],
  "additionalProperties": false
}
