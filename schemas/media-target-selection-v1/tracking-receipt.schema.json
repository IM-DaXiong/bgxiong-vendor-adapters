{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/tracking-receipt.schema.json",
  "type": "object",
  "properties": {
    "selectionDigest": {
      "type": "string",
      "minLength": 1
    },
    "previewMediaId": {
      "type": "string",
      "minLength": 1
    },
    "coveredRange": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "lostRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "shotId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "startMs",
          "endMs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "unresolvedRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "shotId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "startMs",
          "endMs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "ready": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "ok",
        "reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "selectionDigest",
    "previewMediaId",
    "coveredRange",
    "lostRanges",
    "unresolvedRanges",
    "ready"
  ],
  "additionalProperties": false
}
