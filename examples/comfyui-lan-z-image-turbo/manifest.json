{
  "schemaVersion": 2,
  "pluginId": "local.example.comfyui-lan-z-image",
  "displayName": "LAN ComfyUI Z-Image Turbo",
  "version": "0.2.0",
  "language": "rust",
  "entry": "adapter.wasm",
  "capabilitySlots": [
    {
      "slot": "image",
      "taskType": "text_to_image",
      "models": [
        { "modelId": "z.turbo", "displayName": "Z-Image Turbo" }
      ],
      "maxReferenceImages": 0,
      "supportsAsync": true
    }
  ],
  "requestedCapabilities": {
    "endpointPolicy": ["userConfigurable", "allowPrivateNetwork"],
    "allowPrivateNetwork": true,
    "auth": ["none"]
  }
}
