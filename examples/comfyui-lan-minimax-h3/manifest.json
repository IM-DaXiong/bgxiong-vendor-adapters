{
  "schemaVersion": 2,
  "pluginId": "local.example.comfyui-lan-h3",
  "displayName": "LAN ComfyUI MiniMax H3",
  "version": "0.3.1",
  "language": "rust",
  "optionalFeatures": ["video-reference-media-v1"],
  "entry": "adapter.wasm",
  "capabilitySlots": [
    {
      "slot": "video",
      "taskType": "text_to_video",
      "models": [
        { "modelId": "h3.t2v", "displayName": "MiniMax H3 text to video", "promptProjection": { "profileId": "h3", "version": 1, "defaultMethodName": "h3-prompt-writing", "inputModes": ["text_to_video"] } },
        { "modelId": "h3.i2v.turbo", "displayName": "MiniMax H3 turbo single-image reference", "promptProjection": { "profileId": "h3", "version": 1, "defaultMethodName": "h3-prompt-writing", "inputModes": ["image_to_video"] } },
        { "modelId": "h3.r2v.turbo", "displayName": "MiniMax H3 turbo multi-reference", "promptProjection": { "profileId": "h3", "version": 1, "defaultMethodName": "h3-prompt-writing", "inputModes": ["multi_image_to_video"] } }
      ],
      "supportsAsync": true,
      "maxReferenceImages": 3,
      "maxDurationSeconds": 15,
      "features": ["video-reference-media-v1"]
    }
  ],
  "requestedCapabilities": {
    "endpointPolicy": ["userConfigurable", "allowPrivateNetwork"],
    "allowPrivateNetwork": true,
    "auth": ["none"]
  }
}
