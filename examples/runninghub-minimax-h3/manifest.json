{
  "schemaVersion": 2,
  "pluginId": "local.example.runninghub-h3",
  "displayName": "RunningHub MiniMax H3 r2v turbo (V2)",
  "version": "0.2.3",
  "language": "rust",
  "entry": "adapter.wasm",
  "capabilitySlots": [
    {
      "slot": "video",
      "taskType": "text_to_video",
      "models": [{ "modelId": "workflow", "displayName": "MiniMax H3 r2v turbo" }],
      "supportsAsync": true,
      "maxReferenceImages": 2,
      "maxDurationSeconds": 15
    }
  ],
  "requestedCapabilities": {
    "endpointPolicy": ["staticHosts"],
    "networkHosts": ["www.runninghub.ai", "www.runninghub.cn"],
    "auth": ["bearer"]
  }
}
