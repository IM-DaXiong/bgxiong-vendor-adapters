    "SD02": {
      "requiredPaths": [
        "protocol/vendor-adapter-protocol.json",
        "protocol/schema-policy.json",
        "protocol/host-feature-catalog.json",
        "schemas/manifest.schema.json",
        "schemas/worker-envelope.schema.json",
        "schemas/host-ports.schema.json",
        "schemas/checkpoint.schema.json",
        "schemas/profile.schema.json",
        "schemas/policy.schema.json",
        "CONTRACT-DECISIONS.md"
      ],
      "commands": [
        [
          "{python}",
          "-c",
          "import copy,json,sys\nfrom pathlib import Path\nfrom jsonschema import Draft202012Validator\nfrom referencing import Registry,Resource\nroot=Path(sys.argv[1]); schemas={}\nfor path in sorted((root/'schemas').glob('*.json')):\n    schema=json.loads(path.read_text(encoding='utf-8')); Draft202012Validator.check_schema(schema)\n    assert schema['$schema']=='https://json-schema.org/draft/2020-12/schema'\n    assert schema['$id'] not in schemas\n    schemas[schema['$id']]=schema\nassert len(schemas)>=17, 'release contracts incomplete'\nregistry=Registry(retrieve=lambda uri: (_ for _ in ()).throw(ValueError('network schema forbidden')))\nfor uri,schema in schemas.items():registry=registry.with_resource(uri,Resource.from_contents(schema))\ndef refs(node):\n    if isinstance(node,dict):\n        if '$ref' in node:\n            uri,_,pointer=node['$ref'].partition('#')\n            target=schemas[uri] if uri else current\n            for segment in pointer.lstrip('/').split('/') if pointer else []:\n                target=target[segment.replace('~1','/').replace('~0','~')]\n        for value in node.values():refs(value)\n    elif isinstance(node,list):\n        for value in node:refs(value)\nfor current in schemas.values(): refs(current)\nfor filename in ['vendor-adapter-protocol.json','schema-policy.json','host-feature-catalog.json']:\n    json.loads((root/'protocol'/filename).read_text(encoding='utf-8'))\npolicy=json.loads((root/'protocol/schema-policy.json').read_text(encoding='utf-8'))\nDraft202012Validator(schemas['https://bgxiong.local/vendor-adapter/v2/policy.schema.json'],registry=registry).validate(policy)\nassert policy['networkReferences']=='forbidden' and policy['recursiveReferences']=='forbidden'\nassert policy['unknownValidationKeywords']=='reject'\nassert set(json.loads((root/'operation-contracts.json').read_text(encoding='utf-8'))['operations'])==set(json.loads((root/'protocol/vendor-adapter-protocol.json').read_text(encoding='utf-8'))['operations'])\nfor name in ['manifest','worker-envelope','host-ports','checkpoint','profile']:\n    schema=schemas['https://bgxiong.local/vendor-adapter/v2/'+name+'.schema.json']\n    validator=Draft202012Validator(schema,registry=registry)\n    assert not validator.is_valid({'unexpected':True}), name+' unknown fields accepted'\nprint('SD02_LOCAL=PASS schema_meta=PASS local_ref_closure=PASS policy=PASS unknown_fields_rejected=PASS')\n",
          "{sdk}"
        ],
        [
          "{python}",
          "{sdk}/tools/validate_design.py"
        ]
      ]
    },
