{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/local-runtime/v1/bundle.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\\\u0000]).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "runtimes": {
      "type": "array",
      "items": {
        "$ref": "https://bgxiong.local/local-runtime/v1/runtime.schema.json#/$defs/RuntimeSpec"
      },
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "runtimeId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "resourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            },
            "uniqueItems": true
          },
          "revision": {
            "type": "string"
          },
          "speech": {
            "$ref": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-v1/descriptor.schema.json"
          }
        },
        "required": [
          "modelId",
          "runtimeId"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "kind": {
            "enum": [
              "model",
              "runtime",
              "dependency"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "bundled"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\\\u0000]).+$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "download"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "additionalProperties": false
              }
            ]
          },
          "license": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "sha256",
          "byteLength",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "id",
        "keyId"
      ],
      "additionalProperties": false
    },
    "documentation": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\\\u0000]).+$"
    },
    "license": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "adapter",
    "runtimes",
    "models"
  ],
  "additionalProperties": false
}
