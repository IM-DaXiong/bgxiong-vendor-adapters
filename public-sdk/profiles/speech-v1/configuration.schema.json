{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-v1/configuration.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "credentialSlot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    }
  },
  "required": [
    "schemaVersion",
    "origin",
    "instanceId",
    "credentialSlot"
  ],
  "additionalProperties": false
}
