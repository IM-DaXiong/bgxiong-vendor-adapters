{
  "schemaVersion": 2,
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "networkReferences": "forbidden",
  "recursiveReferences": "forbidden",
  "unknownValidationKeywords": "reject",
  "supportedKeywords": [
    "$schema",
    "$id",
    "$ref",
    "$defs",
    "$anchor",
    "type",
    "enum",
    "const",
    "properties",
    "required",
    "additionalProperties",
    "patternProperties",
    "propertyNames",
    "dependentRequired",
    "dependentSchemas",
    "minProperties",
    "maxProperties",
    "items",
    "prefixItems",
    "contains",
    "minContains",
    "maxContains",
    "unevaluatedItems",
    "unevaluatedProperties",
    "minItems",
    "maxItems",
    "uniqueItems",
    "minLength",
    "maxLength",
    "pattern",
    "format",
    "minimum",
    "maximum",
    "exclusiveMinimum",
    "exclusiveMaximum",
    "multipleOf",
    "allOf",
    "anyOf",
    "oneOf",
    "not",
    "if",
    "then",
    "else",
    "title",
    "description",
    "default",
    "examples",
    "deprecated",
    "readOnly",
    "writeOnly",
    "$comment",
    "x-wit-functions",
    "x-wit-interface",
    "x-wit-type",
    "x-mediaKind",
    "x-resourceHint",
    "x-portraitDefault"
  ],
  "formatPolicy": "assert-known-formats-reject-unknown",
  "limits": {
    "maxSchemaBytes": 1048576,
    "maxSchemaNodes": 65536,
    "maxSchemaDepth": 64,
    "maxSchemasPerCapability": 256,
    "maxRefDepth": 64,
    "maxFrameBytes": 8388608,
    "maxBufferedHttpBytes": 1048576,
    "maxHttpChunkBytes": 65536,
    "maxEventQueueBytes": 1048576,
    "maxMediaChunkBytes": 1048576,
    "maxStateBytes": 1048576,
    "maxDiagnosticBytes": 4096,
    "maxModuleBytes": 67108864,
    "maxTableElements": 1048576,
    "maxInstances": 4096,
    "maxMemories": 16,
    "maxTables": 16
  }
}
