{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/worker-envelope.schema.json",
  "title": "WorkerEnvelopeV2",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "hello"
        },
        "protocolVersion": {
          "const": 2
        },
        "witPackage": {
          "const": "bgxiong:vendor-adapter@2.0.0"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "protocolVersion",
        "witPackage",
        "policyDigest"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "invoke"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "object",
          "properties": {
            "pluginId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "pluginId",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "invocation": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/invocation.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "package",
        "invocation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "port_call"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "callId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "call": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/host-ports.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "callId",
        "call"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "port_result"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "callId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ok": {}
              },
              "required": [
                "ok"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "$ref": "https://bgxiong.local/vendor-adapter/v2/host-ports.schema.json#/$defs/hostError"
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "callId",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "cancel"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "response"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "response": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/response.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "response"
      ],
      "additionalProperties": false
    }
  ]
}
