{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/host-channel-v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/ChannelHello"
    },
    {
      "$ref": "#/$defs/ChannelAccept"
    },
    {
      "$ref": "#/$defs/BeforeSend"
    },
    {
      "$ref": "#/$defs/AuditAck"
    },
    {
      "$ref": "#/$defs/MediaBridgeRequest"
    },
    {
      "$ref": "#/$defs/MediaBridgeReply"
    },
    {
      "$ref": "#/$defs/StreamDelivery"
    },
    {
      "$ref": "#/$defs/StreamAck"
    },
    {
      "$ref": "#/$defs/FinalDelivery"
    },
    {
      "$ref": "#/$defs/FinalAck"
    }
  ],
  "$defs": {
    "ChannelHello": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "channel_hello"
        },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "before-send",
              "media-stream"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "features"
      ],
      "additionalProperties": false
    },
    "ChannelAccept": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "channel_accept"
        },
        "enabledFeatures": {
          "type": "array",
          "items": {
            "enum": [
              "before-send",
              "media-stream"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "enabledFeatures"
      ],
      "additionalProperties": false
    },
    "BeforeSend": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "before_send"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "callIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string"
        },
        "body": {},
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "requestId",
        "callIndex",
        "operationId",
        "method",
        "url",
        "body",
        "text"
      ],
      "additionalProperties": false
    },
    "AuditAck": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "audit_ack"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "persisted": {
                  "const": true
                }
              },
              "required": [
                "persisted"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "persisted": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_PACKAGE",
                        "UNSUPPORTED_VERSION",
                        "UNSUPPORTED_FEATURE",
                        "INVALID_INPUT",
                        "UNAUTHORIZED",
                        "PERMISSION_DENIED",
                        "UPSTREAM_ERROR",
                        "RATE_LIMITED",
                        "TIMEOUT",
                        "ACCEPTANCE_UNKNOWN",
                        "RESOURCE_UNAVAILABLE",
                        "CANCEL_UNSUPPORTED",
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "vendorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vendorRequestId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "retryable",
                    "vendorCode",
                    "vendorRequestId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "persisted",
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "result"
      ],
      "additionalProperties": false
    },
    "MediaBridgeRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "media_read"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "requestId",
        "handle",
        "offset",
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "MediaBridgeReply": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "media_read_reply"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "bytesBase64": {
                  "type": "string"
                },
                "eof": {
                  "type": "boolean"
                }
              },
              "required": [
                "bytesBase64",
                "eof"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_PACKAGE",
                        "UNSUPPORTED_VERSION",
                        "UNSUPPORTED_FEATURE",
                        "INVALID_INPUT",
                        "UNAUTHORIZED",
                        "PERMISSION_DENIED",
                        "UPSTREAM_ERROR",
                        "RATE_LIMITED",
                        "TIMEOUT",
                        "ACCEPTANCE_UNKNOWN",
                        "RESOURCE_UNAVAILABLE",
                        "CANCEL_UNSUPPORTED",
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "vendorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vendorRequestId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "retryable",
                    "vendorCode",
                    "vendorRequestId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "result"
      ],
      "additionalProperties": false
    },
    "StreamDelivery": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "stream_event"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/stream-event.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "event"
      ],
      "additionalProperties": false
    },
    "StreamAck": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "stream_ack"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "consumed": {
                  "const": true
                }
              },
              "required": [
                "consumed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_PACKAGE",
                        "UNSUPPORTED_VERSION",
                        "UNSUPPORTED_FEATURE",
                        "INVALID_INPUT",
                        "UNAUTHORIZED",
                        "PERMISSION_DENIED",
                        "UPSTREAM_ERROR",
                        "RATE_LIMITED",
                        "TIMEOUT",
                        "ACCEPTANCE_UNKNOWN",
                        "RESOURCE_UNAVAILABLE",
                        "CANCEL_UNSUPPORTED",
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "vendorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vendorRequestId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "retryable",
                    "vendorCode",
                    "vendorRequestId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "result"
      ],
      "additionalProperties": false
    },
    "FinalDelivery": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "final_response"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "response": {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/response.schema.json"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "response"
      ],
      "additionalProperties": false
    },
    "FinalAck": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "final_ack"
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "adopted": {
                  "const": true
                }
              },
              "required": [
                "adopted"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_PACKAGE",
                        "UNSUPPORTED_VERSION",
                        "UNSUPPORTED_FEATURE",
                        "INVALID_INPUT",
                        "UNAUTHORIZED",
                        "PERMISSION_DENIED",
                        "UPSTREAM_ERROR",
                        "RATE_LIMITED",
                        "TIMEOUT",
                        "ACCEPTANCE_UNKNOWN",
                        "RESOURCE_UNAVAILABLE",
                        "CANCEL_UNSUPPORTED",
                        "INTERNAL_ERROR"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "vendorCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vendorRequestId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "retryable",
                    "vendorCode",
                    "vendorRequestId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "exchangeId",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
