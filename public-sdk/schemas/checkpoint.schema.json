{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/checkpoint.schema.json",
  "title": "ReferenceCheckpointV2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "object",
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "pluginId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityKey": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "operationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "inputSchemaDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputSchemaDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resumeSchemaDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configurationRef": {
      "type": "string",
      "minLength": 1
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "prepared",
        "accepted",
        "acceptance_unknown",
        "terminal"
      ]
    },
    "vendorTaskId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resumeToken": {},
    "mediaIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "file"
            ]
          }
        },
        "required": [
          "id",
          "digest",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "anyOf": [
        {
          "$ref": "https://bgxiong.local/vendor-adapter/v2/result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "requestId",
    "package",
    "bindingId",
    "modelId",
    "capabilityKey",
    "operationId",
    "operationVersion",
    "inputSchemaDigest",
    "outputSchemaDigest",
    "resumeSchemaDigest",
    "configurationDigest",
    "configurationRef",
    "requestDigest",
    "state",
    "vendorTaskId",
    "resumeToken",
    "mediaIdentities",
    "result"
  ],
  "additionalProperties": false
}
