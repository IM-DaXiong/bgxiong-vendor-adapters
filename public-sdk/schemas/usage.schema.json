{
  "type": "object",
  "properties": {
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "source": {
            "const": "reported"
          }
        },
        "required": [
          "metric",
          "unit",
          "amount",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "measurements"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/usage.schema.json"
}
