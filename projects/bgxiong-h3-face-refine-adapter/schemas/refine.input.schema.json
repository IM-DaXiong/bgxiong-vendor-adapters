{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/refine.input.schema.json",
  "type": "object",
  "properties": {
    "freeze": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "mediaId": {
              "type": "string",
              "minLength": 1
            },
            "contentDigest": {
              "type": "string",
              "minLength": 1
            },
            "selectedRange": {
              "type": "object",
              "properties": {
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "startMs",
                "endMs"
              ],
              "additionalProperties": false
            },
            "displayGeometry": {
              "type": "object",
              "properties": {
                "widthPx": {
                  "type": "integer",
                  "minimum": 1
                },
                "heightPx": {
                  "type": "integer",
                  "minimum": 1
                },
                "rotationDegrees": {
                  "type": "integer",
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                },
                "mirrored": {
                  "type": "boolean"
                }
              },
              "required": [
                "widthPx",
                "heightPx",
                "rotationDegrees",
                "mirrored"
              ],
              "additionalProperties": false
            },
            "timeBase": {
              "type": "string",
              "const": "ms-from-selected-range-start"
            },
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "schemaDigest": {
              "type": "string",
              "minLength": 1
            },
            "detectionParamsDigest": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mediaId",
            "contentDigest",
            "selectedRange",
            "displayGeometry",
            "timeBase",
            "packageId",
            "operationId",
            "schemaDigest",
            "detectionParamsDigest"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "properties": {
            "analysisId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "analysisId",
            "revision",
            "digest"
          ],
          "additionalProperties": false
        },
        "selectionDigest": {
          "type": "string",
          "minLength": 1
        },
        "trackingDigest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "dependencyVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1
          }
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "schemaDigest": {
          "type": "string",
          "minLength": 1
        },
        "referenceMediaIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prompt": {
          "type": "string"
        },
        "userParams": {
          "type": "object",
          "properties": {
            "denoise": {
              "type": "number",
              "title": "精修强度",
              "minimum": 0,
              "maximum": 1,
              "default": 0.45
            },
            "smallFaceStrength": {
              "type": "number",
              "title": "小脸增强比例",
              "minimum": 0,
              "maximum": 1,
              "default": 0.8
            },
            "largeFaceStrength": {
              "type": "number",
              "title": "大脸增强比例",
              "minimum": 0,
              "maximum": 1,
              "default": 0.35
            },
            "scaleMode": {
              "type": "string",
              "title": "脸部尺寸衡量方式",
              "enum": [
                "absolute_px",
                "relative_to_clip"
              ],
              "oneOf": [
                {
                  "const": "absolute_px",
                  "title": "按实际像素大小"
                },
                {
                  "const": "relative_to_clip",
                  "title": "按本视频中的相对大小"
                }
              ],
              "default": "absolute_px"
            },
            "samEnabled": {
              "type": "boolean",
              "title": "使用脸形遮罩",
              "default": false
            },
            "samModel": {
              "type": "string",
              "title": "SAM模型文件名",
              "description": "启用脸形遮罩时填写已安装的模型名称"
            },
            "identityMediaIds": {
              "type": "array",
              "title": "身份参考图",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "analysis",
        "selectionDigest",
        "packageVersion",
        "dependencyVersions",
        "operationId",
        "schemaDigest",
        "referenceMediaIds",
        "prompt",
        "userParams"
      ],
      "additionalProperties": false
    },
    "selection": {
      "$ref": "selection.schema.json"
    },
    "tracking": {
      "$ref": "tracking-receipt.schema.json"
    }
  },
  "required": [
    "freeze",
    "selection"
  ],
  "additionalProperties": false
}
