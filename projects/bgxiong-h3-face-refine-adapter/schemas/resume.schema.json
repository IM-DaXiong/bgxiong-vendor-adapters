{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operationId": {
      "enum": [
        "local.thirdparty.h3-face-refine/subjects.preview",
        "local.thirdparty.h3-face-refine/video.refine"
      ]
    },
    "promptId": {
      "type": "string",
      "minLength": 1
    },
    "selectionDigest": {
      "type": "string",
      "minLength": 1
    },
    "coveredRange": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "contentDigest": {
          "type": "string",
          "minLength": 1
        },
        "selectedRange": {
          "type": "object",
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0
            },
            "endMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "startMs",
            "endMs"
          ],
          "additionalProperties": false
        },
        "displayGeometry": {
          "type": "object",
          "properties": {
            "widthPx": {
              "type": "integer",
              "minimum": 1
            },
            "heightPx": {
              "type": "integer",
              "minimum": 1
            },
            "rotationDegrees": {
              "type": "integer",
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "mirrored": {
              "type": "boolean"
            }
          },
          "required": [
            "widthPx",
            "heightPx",
            "rotationDegrees",
            "mirrored"
          ],
          "additionalProperties": false
        },
        "timeBase": {
          "type": "string",
          "const": "ms-from-selected-range-start"
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "schemaDigest": {
          "type": "string",
          "minLength": 1
        },
        "detectionParamsDigest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mediaId",
        "contentDigest",
        "selectedRange",
        "displayGeometry",
        "timeBase",
        "packageId",
        "operationId",
        "schemaDigest",
        "detectionParamsDigest"
      ],
      "additionalProperties": false
    },
    "freezeDigest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "operationId",
    "promptId",
    "selectionDigest",
    "coveredRange",
    "source"
  ],
  "additionalProperties": false
}
