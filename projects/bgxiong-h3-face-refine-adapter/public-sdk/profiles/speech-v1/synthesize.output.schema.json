{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-v1/synthesize.output.schema.json",
  "anyOf": [
    {
      "$ref": "https://bgxiong.local/vendor-adapter/v2/profiles/speech-v1/synthesize.input.schema.json#/$defs/SpeechData"
    },
    {
      "type": "null"
    }
  ],
  "$defs": {
    "AudioInfo": {
      "type": "object",
      "properties": {
        "sampleRateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frames": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "codec": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "voiceId": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Alignment": {
      "type": "object",
      "properties": {
        "unit": {
          "enum": [
            "sentence",
            "word",
            "phoneme"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "scalarStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "scalarEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "unit",
        "entries"
      ],
      "additionalProperties": false
    },
    "Segments": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "minimum": 0
              },
              "scalarStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "scalarEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "ParameterReceipt": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "pointer",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "notApplied": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "unsupported",
                  "out_of_range",
                  "not_applicable",
                  "unknown_extension",
                  "missing_optional_input"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "pointer",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Performance": {
      "type": "object",
      "properties": {
        "firstAudioMs": {
          "type": "number",
          "minimum": 0
        },
        "inferenceMs": {
          "type": "number",
          "minimum": 0
        },
        "totalMs": {
          "type": "number",
          "minimum": 0
        },
        "peakRamBytes": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "peakVramBytes": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Annotation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {},
        "score": {
          "type": "number"
        },
        "scale": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "source": {
          "enum": [
            "model",
            "adapter",
            "human"
          ]
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "audio_info",
            "alignment",
            "segments",
            "parameter_receipt",
            "performance",
            "annotation",
            "diagnostic",
            "extension"
          ]
        },
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "payload": {}
      },
      "required": [
        "kind",
        "payload"
      ],
      "additionalProperties": false
    }
  }
}
